PORT=3001
JWT_SECRET=string-acak-panjang-minimal-32-karakter
NODE_ENV=production
FRONTEND_URL=http://ip-server-anda
TRUST_PROXY=true
RATE_LIMIT_MAX=1000

# Migrasi skema dijalankan otomatis saat server start (default). Set 0 untuk
# melewatinya, mis. bila migrasi dijalankan manual lewat `npm run db:migrate`.
# MIGRATE_ON_START=0

# Retensi baris lama untuk `npm run db:maintenance` (hari).
# penjemputan_log default 0 karena berisi data bisnis riwayat penjemputan,
# bukan log teknis — aktifkan sadar-sadar bila memang tidak dibutuhkan lagi.
# RETENTION_AUDIT_LOG_DAYS=730
# RETENTION_NFC_SCAN_LOG_DAYS=180
# RETENTION_PENJEMPUTAN_LOG_DAYS=0
# VACUUM menulis ulang seluruh file database dan butuh ruang kosong sekitar
# seukuran database, jadi opt-in. Set 1 bila sudah yakin ruangnya cukup.
# MAINTENANCE_VACUUM=0

# Logging (pino). Level: trace|debug|info|warn|error|fatal|silent.
# Production selalu JSON; development otomatis pretty-print.
# Set LOG_PRETTY=0 untuk memaksa JSON di development.
LOG_LEVEL=info

# Error tracking (opsional). Biarkan kosong untuk menonaktifkan sepenuhnya —
# tanpa DSN, @sentry/node tidak pernah dimuat.
# SENTRY_DSN=https://xxx@o000000.ingest.sentry.io/0000000
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=siaga@1.0.0
# Tracing dimatikan secara default (0). Naikkan sadar-sadar bila butuh.
# SENTRY_TRACES_SAMPLE_RATE=0
# Sistem menyimpan data anak/wali. Jangan aktifkan PII tanpa alasan kuat.
# SENTRY_SEND_PII=0

# Hanya dibutuhkan saat sengaja menjalankan `npm run init`.
# RESET_DATABASE_CONFIRM=HAPUS_DATABASE_SIAGA

# Google Cloud Storage Backup Settings (Optional)
# GCS_BUCKET_NAME=your-gcs-bucket-name
# GCS_KEY_FILE_PATH=./gcs-key.json
# BACKUP_DIR=/var/backups/siaga
# BACKUP_RETENTION_COUNT=30

# ---------------------------------------------------------------------------
# Kanal notifikasi WhatsApp (opsional)
# ---------------------------------------------------------------------------
# PENTING — BACA SEBELUM MENGAKTIFKAN:
# open-wa mengotomasi WhatsApp Web dan MELANGGAR Ketentuan Layanan Meta.
# Nomor sekolah yang dipakai berisiko diblokir. Gunakan nomor khusus (bukan
# nomor utama sekolah) dan siapkan nomor cadangan. Detail lengkap + langkah
# setup: docs/whatsapp.md
#
# none (bawaan) = kanal mati, aplikasi hanya memakai notifikasi in-app + push
# log            = tidak mengirim apa pun (untuk tes/dev)
# openwa         = Easy API open-wa yang berjalan terpisah (HTTP)
# gateway        = reseller resmi (Fonnte/Wablas/dll) lewat HTTP generik
# WA_PROVIDER=none
# WA_DELAY_MS=1500

# --- Untuk WA_PROVIDER=openwa ---
# Easy API dijalankan terpisah:
#   WA_API_KEY=ganti-dengan-kunci-panjang WA_API_URL=http://127.0.0.1:8080
#   npx @open-wa/wa-automate@5.6.6 --session-id siaga --host 127.0.0.1 --port 8080 --api-key "$WA_API_KEY"
# Lalu pindai QR di http://127.0.0.1:8080/dashboard/ dengan HP nomor sekolah.
# WA_API_URL=http://127.0.0.1:8080
# WA_API_KEY=

# --- Untuk WA_PROVIDER=gateway ---
# WA_GATEWAY_URL=https://api.fonnte.com/send
# WA_GATEWAY_TOKEN=

# Tipe notifikasi yang BOLEH dikirim ke WhatsApp orang tua.
# Sengaja dibatasi: jangan sampai notifikasi operasional internal mengganggu
# orang tua (dan memperbesar risiko nomor diblokir).
# WA_TIPE_AKTIF=daily_published,guru_reply,payment_verified,payment_rejected,invoice_issued,payment_claim
