{
  "name": "siaga",
  "engines": {
    "node": "22.x"
  },
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:stable": "concurrently \"npm run dev:stable --prefix backend\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix frontend",
    "start": "node backend/server.js",
    "init": "node backend/init.js",
    "smoke": "node scripts/smoke.js",
    "smoke:prod": "node scripts/prod-smoke.js",
    "test": "node scripts/run-tests.js main",
    "test:workflow": "node scripts/run-tests.js workflow",
    "test:frontend": "node scripts/run-frontend-tests.js",
    "test:all": "npm test && npm run test:workflow && npm run test:frontend",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js",
    "db:migrate": "node backend/migrate.js",
    "db:maintenance": "node scripts/maintenance.js",
    "db:maintenance:dry": "node scripts/maintenance.js --dry-run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test --config e2e/playwright.config.js"
  },
  "dependencies": {
    "concurrently": "^8.2.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "prettier": "^3.9.10"
  }
}
