{
  "name": "siaga-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "design:lint": "node node_modules/@google/design.md/dist/index.js lint DESIGN.md",
    "design:export": "node node_modules/@google/design.md/dist/index.js export --format tailwind DESIGN.md > tailwind.theme.json",
    "predev": "npm run design:export",
    "dev": "node dev.mjs",
    "prebuild": "npm run design:export",
    "build": "node build.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@google/design.md": "^0.1.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
